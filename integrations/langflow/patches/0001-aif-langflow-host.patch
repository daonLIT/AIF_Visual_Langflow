diff --git a/src/frontend/src/aif/AifIntegrationCheckPage.tsx b/src/frontend/src/aif/AifIntegrationCheckPage.tsx
new file mode 100644
index 0000000..8c2ca22
--- /dev/null
+++ b/src/frontend/src/aif/AifIntegrationCheckPage.tsx
@@ -0,0 +1,56 @@
+import { useEffect, useState } from "react";
+import { useLocation } from "react-router-dom";
+import { Button } from "@/components/ui/button";
+import { useCustomNavigate } from "@/customization/hooks/use-custom-navigate";
+import { aifHost } from "./aifHostBridge";
+
+// P0 검증용 페이지: 포크한 프런트엔드가 실제 Desktop 창에 로드됐는지 확인한다.
+// 빌드 표식은 vite define 이 아니라 빌드 스크립트가 쓰는 env 로 주입한다.
+const BUILD_MARK = import.meta.env.VITE_AIF_BUILD_MARK ?? "dev";
+
+export default function AifIntegrationCheckPage(): JSX.Element {
+  const navigate = useCustomNavigate();
+  const location = useLocation();
+  const [visits, setVisits] = useState<number | null>(null);
+
+  useEffect(() => {
+    // 새로고침·앱 재시작 후에도 같은 페이지로 돌아왔는지 세기 위한 표식
+    try {
+      const next = Number(localStorage.getItem("aif-check-visits") ?? "0") + 1;
+      localStorage.setItem("aif-check-visits", String(next));
+      setVisits(next);
+    } catch {
+      setVisits(null);
+    }
+  }, []);
+
+  const host = aifHost;
+
+  return (
+    <div
+      className="flex h-full w-full flex-col gap-4 overflow-auto p-8"
+      data-testid="aif-integration-check"
+    >
+      <h1 className="text-2xl font-semibold">AIF Integration Check</h1>
+      <dl className="grid max-w-2xl grid-cols-[10rem_1fr] gap-x-4 gap-y-2 text-sm">
+        <dt className="text-muted-foreground">Build</dt>
+        <dd data-testid="aif-build-mark">{BUILD_MARK}</dd>
+        <dt className="text-muted-foreground">Path</dt>
+        <dd>{location.pathname}</dd>
+        <dt className="text-muted-foreground">Origin</dt>
+        <dd>{window.location.origin}</dd>
+        <dt className="text-muted-foreground">Host</dt>
+        <dd data-testid="aif-host">
+          {host ? `${host.kind} ${host.version ?? ""}` : "browser"}
+        </dd>
+        <dt className="text-muted-foreground">Visits</dt>
+        <dd>{visits ?? "storage unavailable"}</dd>
+      </dl>
+      <div>
+        <Button onClick={() => navigate("/flows")} data-testid="aif-back">
+          Flow 목록으로
+        </Button>
+      </div>
+    </div>
+  );
+}
diff --git a/src/frontend/src/aif/AifProjectPage.tsx b/src/frontend/src/aif/AifProjectPage.tsx
new file mode 100644
index 0000000..de04f86
--- /dev/null
+++ b/src/frontend/src/aif/AifProjectPage.tsx
@@ -0,0 +1,85 @@
+import {
+  AifWorkbench,
+  LanguageToggle,
+  useAnnotationStore,
+  useServerProject,
+} from "@aif/workbench";
+import { useT } from "@aif/workbench/i18n";
+import { useState } from "react";
+import { useParams } from "react-router-dom";
+import { useCustomNavigate } from "@/customization/hooks/use-custom-navigate";
+import { aifHost } from "./aifHost";
+
+export default function AifProjectPage(): JSX.Element {
+  const { projectId = "" } = useParams();
+  const navigate = useCustomNavigate();
+  const t = useT();
+  const [notice, setNotice] = useState<string | null>(null);
+  const loadedId = useAnnotationStore((s) => s.projectId);
+  // 저장 안 한 편집을 지키려고 이동을 취소하면 편집 중인 프로젝트 주소로 돌아간다.
+  const state = useServerProject(projectId, (editing) =>
+    navigate(`/aif/projects/${encodeURIComponent(editing)}`, { replace: true }),
+  );
+
+  const openWeb = async () => {
+    if (!aifHost?.openWeb) return;
+    const result = await aifHost.openWeb(projectId);
+    setNotice(result.ok ? null : t("projects.openWeb.unset"));
+  };
+
+  const bar = (
+    <div className="top-bar project-bar">
+      <button
+        type="button"
+        onClick={() => navigate("/aif/projects")}
+        data-testid="aif-back-to-list"
+      >
+        {t("projects.back")}
+      </button>
+      <span className="top-bar-title">{projectId}</span>
+      {state.kind === "loading" ? (
+        <span className="project-list-note">{t("projects.opening")}</span>
+      ) : null}
+      {notice ? (
+        <span className="project-list-note is-error">{notice}</span>
+      ) : null}
+      <span className="status-spacer" />
+      {aifHost?.openWeb && state.kind === "ready" ? (
+        <button
+          type="button"
+          onClick={() => void openWeb()}
+          data-testid="aif-open-web"
+        >
+          {t("projects.openWeb")}
+        </button>
+      ) : null}
+      <LanguageToggle />
+    </div>
+  );
+
+  if (state.kind === "error") {
+    return (
+      <div
+        className="aif-root aif-langflow-host"
+        data-testid="aif-project-page"
+      >
+        <div className="app-shell">
+          {bar}
+          <p className="project-list-note is-error aif-load-error" role="alert">
+            {state.message}
+          </p>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div
+      className="aif-root aif-langflow-host"
+      data-testid="aif-project-page"
+      data-loaded-project={state.kind === "ready" ? loadedId : ""}
+    >
+      <AifWorkbench topBar={bar} />
+    </div>
+  );
+}
