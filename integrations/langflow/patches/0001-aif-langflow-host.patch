diff --git a/src/frontend/src/aif/AifPublishPanel.tsx b/src/frontend/src/aif/AifPublishPanel.tsx
new file mode 100644
index 0000000..ddc69a2
--- /dev/null
+++ b/src/frontend/src/aif/AifPublishPanel.tsx
@@ -0,0 +1,147 @@
+import { useMemo, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { useCustomNavigate } from "@/customization/hooks/use-custom-navigate";
+import useFlowStore from "@/stores/flowStore";
+import { aifHost } from "./aifHostBridge";
+
+// Flow 화면에서 AIF Publish 노드의 "이번 실행" 결과를 보여 주고, 저장된 프로젝트를 같은 창의 검토 화면으로 연다.
+// - 노드는 출력 이름 publish_result 로 찾는다(노드 ID·표시 이름은 사용자가 바꿀 수 있다).
+// - Flow 가 실행 중이면 숨긴다. 이전 실행의 링크를 새 실행 결과로 보이지 않게 하기 위해서다.
+// - 링크는 이 실행의 출력에 들어 있는 projectId 만 쓴다(전역 '마지막 결과'를 쓰지 않는다).
+
+type PublishSummary = {
+  analysisStatus?: string;
+  publishStatus?: "saved" | "failed" | "skipped";
+  duplicate?: boolean;
+  projectId?: string;
+  externalRunId?: string;
+  error?: string;
+  retryable?: boolean;
+  errors?: string[];
+};
+
+function messageText(message: unknown): string {
+  if (typeof message === "string") return message;
+  if (message && typeof message === "object") {
+    const value = message as { text?: unknown; data?: { text?: unknown } };
+    if (typeof value.text === "string") return value.text;
+    if (typeof value.data?.text === "string") return value.data.text;
+  }
+  return "";
+}
+
+export function parsePublishSummary(text: string): PublishSummary | null {
+  const match = text.match(/```json\s*([\s\S]*?)\s*```/);
+  if (!match) return null;
+  try {
+    const value = JSON.parse(match[1]);
+    return value && typeof value === "object" && "publishStatus" in value
+      ? value
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export default function AifPublishPanel(): JSX.Element | null {
+  const navigate = useCustomNavigate();
+  const nodes = useFlowStore((state) => state.nodes);
+  const flowPool = useFlowStore((state) => state.flowPool);
+  const isBuilding = useFlowStore((state) => state.isBuilding);
+  const [retryNote, setRetryNote] = useState<string | null>(null);
+
+  const summary = useMemo(() => {
+    const publishNode = nodes.find((node) =>
+      // biome-ignore lint/suspicious/noExplicitAny: Langflow 노드 데이터는 느슨한 타입이다
+      ((node.data as any)?.node?.outputs ?? []).some(
+        (output: { name?: string }) => output?.name === "publish_result",
+      ),
+    );
+    if (!publishNode) return null;
+    const entries = flowPool[publishNode.id] ?? [];
+    const latest = entries[entries.length - 1];
+    const output = latest?.data?.outputs?.publish_result;
+    return output ? parsePublishSummary(messageText(output.message)) : null;
+  }, [nodes, flowPool]);
+
+  if (isBuilding || !summary) return null;
+
+  // 게시만 다시 보낸다(같은 실행 ID). 노드를 다시 실행하면 Langflow 가 앞 단계까지 다시 돌려 새 분석이 된다.
+  const retry = async () => {
+    if (!aifHost?.retryOutbox) return;
+    setRetryNote("다시 보내는 중…");
+    const report = await aifHost.retryOutbox();
+    const name = `${summary.externalRunId}.json`;
+    setRetryNote(
+      report.sent.includes(name)
+        ? "다시 보냄: 저장됐습니다. 사건 목록에서 여세요."
+        : report.failed.includes(name)
+          ? "서버가 거절했습니다(내용 문제). outbox/failed 에 옮겼습니다."
+          : "아직 보내지 못했습니다. 연결을 확인한 뒤 다시 시도하세요.",
+    );
+  };
+
+  const saved = summary.publishStatus === "saved" && summary.projectId;
+  return (
+    <div
+      className="fixed bottom-4 right-4 z-50 max-w-sm rounded-lg border bg-background p-3 text-sm shadow-lg"
+      data-testid="aif-publish-panel"
+      data-publish-status={summary.publishStatus}
+      data-project-id={summary.projectId ?? ""}
+      data-external-run-id={summary.externalRunId ?? ""}
+    >
+      <div className="font-semibold">
+        {saved
+          ? summary.duplicate
+            ? "AIF 게시: 이미 저장된 결과"
+            : "AIF 게시: 저장됨"
+          : summary.publishStatus === "skipped"
+            ? `AIF 게시 안 함 (분석 ${summary.analysisStatus})`
+            : "AIF 게시 실패"}
+      </div>
+      {summary.publishStatus === "failed" ? (
+        <div className="mt-1 text-destructive">
+          {summary.error}
+          {summary.retryable
+            ? " · 로컬 outbox 에 보관했습니다(셸이 다시 보냅니다)."
+            : ""}
+        </div>
+      ) : null}
+      {summary.publishStatus === "failed" &&
+      summary.retryable &&
+      aifHost?.retryOutbox ? (
+        <Button
+          className="mt-2"
+          size="sm"
+          variant="outline"
+          ignoreTitleCase
+          data-testid="aif-retry-publish"
+          onClick={() => void retry()}
+        >
+          다시 보내기
+        </Button>
+      ) : null}
+      {retryNote ? <div className="mt-1">{retryNote}</div> : null}
+      {summary.errors?.length ? (
+        <ul className="mt-1 list-disc pl-4 text-muted-foreground">
+          {summary.errors.slice(0, 3).map((error) => (
+            <li key={error}>{error}</li>
+          ))}
+        </ul>
+      ) : null}
+      {saved ? (
+        <Button
+          className="mt-2"
+          size="sm"
+          ignoreTitleCase
+          data-testid="aif-open-result"
+          onClick={() =>
+            navigate(`/aif/projects/${encodeURIComponent(summary.projectId!)}`)
+          }
+        >
+          이 결과 보기
+        </Button>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/frontend/src/aif/__tests__/aifPublishPanel.test.ts b/src/frontend/src/aif/__tests__/aifPublishPanel.test.ts
new file mode 100644
index 0000000..31baf65
--- /dev/null
+++ b/src/frontend/src/aif/__tests__/aifPublishPanel.test.ts
@@ -0,0 +1,30 @@
+import { parsePublishSummary } from "../AifPublishPanel";
+
+describe("parsePublishSummary", () => {
+  it("reads the machine-readable block of the AIF Publish output", () => {
+    const text = [
+      "**AIF 게시: 저장됨** (분석: ok)",
+      "[AIF 검토 화면에서 열기](/aif/projects/project-1)",
+      "",
+      "```json",
+      JSON.stringify({
+        analysisStatus: "ok",
+        publishStatus: "saved",
+        projectId: "project-1",
+        externalRunId: "lfd-1",
+      }),
+      "```",
+    ].join("\n");
+    expect(parsePublishSummary(text)).toMatchObject({
+      publishStatus: "saved",
+      projectId: "project-1",
+      externalRunId: "lfd-1",
+    });
+  });
+
+  it("ignores other messages", () => {
+    expect(parsePublishSummary("plain text")).toBeNull();
+    expect(parsePublishSummary('```json\n{"status": "ok"}\n```')).toBeNull();
+    expect(parsePublishSummary("```json\n{broken\n```")).toBeNull();
+  });
+});
