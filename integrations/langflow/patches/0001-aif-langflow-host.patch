@@ -0,0 +1,23 @@
+// Desktop 셸(preload)이 알려 주는 호스트 정보와 동작. 셸 밖(브라우저)에서는 undefined.
+// AIF 화면 코드(@aif/workbench)를 끌어오지 않으므로 메인 번들에서 써도 된다.
+export type AifHostBridge = {
+  kind: string;
+  version?: string;
+  apiBase?: string;
+  openWeb?: (projectId: string) => Promise<{ ok: boolean; reason?: string }>;
+  openSettings?: () => Promise<void>;
+  retryOutbox?: () => Promise<{
+    sent: string[];
+    kept: string[];
+    failed: string[];
+  }>;
+};
+
+declare global {
+  interface Window {
+    aifHost?: AifHostBridge;
+  }
+}
+
+export const aifHost: AifHostBridge | undefined =
+  typeof window !== "undefined" ? window.aifHost : undefined;
