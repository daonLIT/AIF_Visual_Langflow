+import "./aif-host.css";
+
+export { aifHost };
+
+// Desktop 셸 안에서는 같은 출처의 /aif-bridge 로 보내고 셸이 중앙 서버로 넘긴다(토큰은 셸만 안다).
+// 셸 밖(개발용 브라우저)에서는 빌드 때 정한 VITE_AIF_API_BASE.
+configureWorkbench({
+  apiBase: aifHost?.apiBase ?? import.meta.env.VITE_AIF_API_BASE ?? "",
+  // 분석은 Langflow 에서 Flow 를 실행해 만든다. 사이트용 분석 버튼은 숨긴다.
+  analysis: false,
+});
diff --git a/src/frontend/src/aif/aifHostBridge.ts b/src/frontend/src/aif/aifHostBridge.ts
