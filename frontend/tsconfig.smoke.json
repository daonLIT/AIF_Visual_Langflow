{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "outDir": ".tmp-smoke",
    "rootDir": "..",
    "paths": {
      "@aif/workbench/*": [
        "../packages/aif-workbench/src/*"
      ]
    }
  },
  "include": [
    "scripts/smokeTest.ts",
    "scripts/annotationSmoke.ts",
    "scripts/storeSmoke.ts",
    "../packages/aif-workbench/src/io/**/*",
    "../packages/aif-workbench/src/layout/**/*",
    "../packages/aif-workbench/src/validation/**/*",
    "../packages/aif-workbench/src/utils/**/*",
    "../packages/aif-workbench/src/types/**/*",
    "../packages/aif-workbench/src/store/**/*",
    "src/store/**/*",
    "../packages/aif-workbench/src/api/**/*",
    "scripts/v2Smoke.ts",
    "src/pipeline/**/*"
  ]
}
