{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "outDir": ".tmp-smoke",
    "rootDir": "."
  },
  "include": [
    "scripts/smokeTest.ts",
    "scripts/annotationSmoke.ts",
    "scripts/storeSmoke.ts",
    "src/io/**/*",
    "src/layout/**/*",
    "src/validation/**/*",
    "src/utils/**/*",
    "src/types/**/*",
    "src/store/**/*",
    "src/api/**/*",
    "scripts/v2Smoke.ts",
    "src/pipeline/**/*"
  ]
}
