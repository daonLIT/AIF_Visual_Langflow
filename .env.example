# ---- Langflow 중계 서버 (backend/.env 또는 프로젝트 루트 .env 로 복사해서 사용. backend/.env 가 우선) ----
# mock  : 실제 Langflow 를 호출하지 않고 backend/fixtures 의 응답 fixture 를 사용 (기본값)
#         파이프라인 탭은 langflow/ 의 flow 파일을 SQLite 에 복제해 편집한다
# live  : LANGFLOW_BASE_URL 의 실제 서버 호출
# 다른 값이면 서버가 시작하지 않는다
LANGFLOW_MODE=mock
LANGFLOW_BASE_URL=http://localhost:7860
# 복제 flow 를 가져온 뒤 Langflow 화면/API 예제에서 확인한 실제 Flow ID
LANGFLOW_FLOW_ID=
# Langflow API 키. 브라우저 번들에 절대 넣지 않는다. 채팅에 붙여 넣지 말고 이 파일에만 기록한다.
LANGFLOW_API_KEY=
# flow 안의 커스텀 입력 / 최종 출력 컴포넌트 ID (저장소 flow 파일 기준값)
# Langflow 화면에서 가져오면 ID 가 바뀔 수 있다. 서버는 flow 마다 유일한 후보를 찾아 쓰고 경고하며, 후보가 여럿이면 [검증] 메시지의 ID 로 바꾼다.
LANGFLOW_INPUT_COMPONENT_ID=CustomComponent-k5fj9
LANGFLOW_OUTPUT_COMPONENT_ID=ChatOutput-nL1VD
# 서버 측 실행 제한(초). Langflow 컴포넌트의 timeout=0 은 무제한이므로 여기서 제한한다.
LANGFLOW_TIMEOUT_SECONDS=2000
# 동시에 실행할 분석 수 (Ollama 자원 경합 방지)
ANALYSIS_MAX_CONCURRENCY=1
# SQLite 파일 경로 (기본: backend/data/annotation.sqlite3)
# DATABASE_PATH=
# mock 모드 응답 지연(초) — UI 의 "분석 중" 상태를 확인할 때 사용
LANGFLOW_MOCK_DELAY_SECONDS=1.5
# 카탈로그 경로 (기본: backend/catalog/)
# ISSUE_CATALOG_PATH=
# SCHEME_CATALOG_PATH=
# mock 모드 파이프라인 편집용 flow 파일 (여러 개는 ; 로 구분, 기본: langflow/TopDown_Judgment_to_AIF_v11_Top3Issues.json)
# LANGFLOW_MOCK_FLOW_FILES=
# live 실행을 flow 해시별 실행용 스냅샷 flow 로 할지 (실행 중 flow 편집이 진행 중 요청에 섞이지 않게 함, 기본 true)
# RUN_SNAPSHOT_FLOWS=true
# 지정하면 live 응답 envelope 를 저장 (fixture 확보용. 판결문 원문이 들어 있으므로 저장소에 넣지 않는다)
# LANGFLOW_CAPTURE_DIR=backend/data/captures

# ---- 인증 · Langflow Desktop 결과 게시 ----
# off   : 로컬 개발용. 인증 없이 모든 권한 (기본값)
# token : /api/health 를 뺀 모든 /api 요청에 Authorization: Bearer <토큰> 필요. 공개 배포 전에는 반드시 token
# 다른 값이면 서버가 시작하지 않는다
AIF_AUTH_MODE=off
# 토큰 파일(sha256 만 저장). python backend/scripts/manage_tokens.py 로 만든다 (기본: backend/data/api_tokens.json)
# AIF_API_TOKENS_FILE=
# 게시 응답 viewerUrl 을 만들 공개 사이트 주소. 비우면 viewerUrl 은 null
# AIF_PUBLIC_SITE_URL=https://aif.example.org
# 게시 요청 본문 상한(바이트, 기본 6000000)
# AIF_MAX_PUBLISH_BYTES=6000000
# 브라우저 로그인 계정 파일(scrypt 해시만 저장). python backend/scripts/manage_users.py 로 만든다 (기본: backend/data/users.json)
# AIF_USERS_FILE=
# 로그인 세션 유효 시간(시간, 기본 12)
# AIF_SESSION_TTL_HOURS=12
# 세션 쿠키 Secure 속성: auto(https 일 때) | true | false
# AIF_COOKIE_SECURE=auto
