# 중앙 AIF 서버 배포 설정. deploy/.env 로 복사해서 채운다(.env 는 저장소에 넣지 않는다).

# 공개 도메인(DNS 가 이 서버를 가리켜야 Caddy 가 인증서를 받는다). 로컬 시험은 localhost.
AIF_DOMAIN=aif.example.org
# 인증서 만료 알림 이메일은 deploy/Caddyfile 맨 위 전역 블록에 넣는다(선택)

# 로그인 세션 유효 시간(시간)
AIF_SESSION_TTL_HOURS=12
# 게시 요청 본문 상한(바이트)
AIF_MAX_PUBLISH_BYTES=6000000

# 백업을 둘 호스트 폴더 (컨테이너 안 /backups)
AIF_BACKUP_DIR=./backups
# 포트 (로컬 시험에서 80/443 이 쓰이고 있으면 바꾼다)
AIF_HTTP_PORT=80
AIF_HTTPS_PORT=443
# 이미지 태그 (업데이트·원복 때 구분)
AIF_IMAGE_TAG=local
